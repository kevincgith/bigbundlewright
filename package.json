{
  "name": "bigbundle-wright",
  "version": "0.2.0",
  "private": true,
  "description": "Big Bundle Wright: court bundles fit for a 大狀. Browser-only PD 5.6 trial bundle builder.",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bigbundle-wright": "cli/cli.ts"
  },
  "scripts": {
    "cli": "node cli/cli.ts",
    "fixtures": "node test/fixtures/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/copy-pdfjs-assets.ts",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.15.2",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.2.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
